    <!-- JAVASCRIPT LOGIC -->
    <script>
        let artworkCatalog = [];
        let currentCart = [];
        let activeCategory = "All";

        // Loads JSON generated by Python script from Excel file
        async function loadArtworks() {
            const grid = document.getElementById("artGrid");
            try {
                // Attempts to fetch JSON generated from Excel file
                const response = await fetch('artworks.json');
                if (!response.ok) throw new Error("artworks.json not found, using fallback catalog");
                const data = await response.json();
                
                artworkCatalog = data.map(item => ({
                    id: String(item.ID || item.id),
                    title: item.Title || item.title,
                    category: item.Category || item.category || "Acrylic",
                    medium: item.Medium || item.medium || "Mixed Medium",
                    priceOriginal: parseInt(item.Price_Original_INR || item.priceOriginal || 0),
                    pricePrint: parseInt(item.Price_Print_INR || item.pricePrint || 0),
                    availability: item.Availability || item.availability || "Available",
                    image: item.Image_URL || item.image || "https://via.placeholder.com/600",
                    description: item.Description || item.description || ""
                }));
            } catch (err) {
                console.warn(err.message);
                // Default fallback if artworks.json isn't present locally yet
                artworkCatalog = [
                    { id: "101", title: "Divine Ganesha", category: "Acrylic", medium: "Acrylic on Canvas", priceOriginal: 25000, pricePrint: 1800, availability: "Available", image: "https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=800&q=80", description: "Textured acrylic painting depicting traditional warmth." },
                    { id: "102", title: "Monsoon Serenade", category: "Watercolor", medium: "Watercolor on Paper", priceOriginal: 12000, pricePrint: 1200, availability: "Available", image: "https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=800&q=80", description: "Luminous watercolor painting capturing rainy mornings." },
                    { id: "103", title: "Heritage Courtyard", category: "Sketches", medium: "Charcoal on Paper", priceOriginal: 8500, pricePrint: 950, availability: "Available", image: "https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=800&q=80", description: "Detailed charcoal sketch of Indian architecture." },
                    { id: "104", title: "Varanasi Lights", category: "Digital", medium: "Digital Fine Art", priceOriginal: 0, pricePrint: 1500, availability: "Available", image: "https://images.unsplash.com/photo-1518998053901-5348d3961a04?auto=format&fit=crop&w=800&q=80", description: "Digital vector artwork celebrating evening ghats." }
                ];
            }
            renderGallery();
        }

        function renderGallery() {
            const grid = document.getElementById("artGrid");
            grid.innerHTML = "";

            const filtered = activeCategory === "All" 
                ? artworkCatalog 
                : artworkCatalog.filter(item => item.category.toLowerCase() === activeCategory.toLowerCase());

            if (filtered.length === 0) {
                grid.innerHTML = `<p class="col-span-full text-center text-zinc-500 py-10">No artworks found in this category.</p>`;
                return;
            }

            filtered.forEach(art => {
                const card = document.createElement("div");
                card.className = "bg-white rounded-lg shadow-md overflow-hidden border border-zinc-200 flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="relative h-64 overflow-hidden bg-zinc-100">
                            <img src="${art.image}" alt="${art.title}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 right-3 bg-zinc-900/80 text-brand-gold text-[10px] font-bold px-2 py-1 uppercase rounded tracking-wider backdrop-blur-sm">
                                ${art.medium}
                            </span>
                        </div>
                        <div class="p-5">
                            <h3 class="font-heading font-bold text-lg text-zinc-900">${art.title}</h3>
                            <p class="text-zinc-500 text-xs mt-1 line-clamp-2">${art.description}</p>
                            
                            <div class="mt-4 pt-3 border-t border-zinc-100 flex items-center justify-between">
                                <div>
                                    ${art.priceOriginal > 0 ? `<p class="text-xs text-zinc-500">Original: <strong class="text-zinc-900 text-sm">₹${art.priceOriginal.toLocaleString('en-IN')}</strong></p>` : ''}
                                    ${art.pricePrint > 0 ? `<p class="text-xs text-zinc-500">Print from: <strong class="text-zinc-900 text-sm">₹${art.pricePrint.toLocaleString('en-IN')}</strong></p>` : ''}
                                </div>
                                <span class="text-xs font-semibold ${art.availability === 'Available' ? 'text-emerald-600' : 'text-red-500'}">
                                    ${art.availability}
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="p-5 pt-0 flex gap-2">
                        ${art.priceOriginal > 0 && art.availability === 'Available' ? `
                            <button onclick="addToCart('${art.id}', 'Original', ${art.priceOriginal})" class="flex-1 bg-zinc-900 text-white text-xs font-bold py-2 rounded hover:bg-brand-gold hover:text-zinc-900 transition-colors">Buy Original</button>
                        ` : ''}
                        ${art.pricePrint > 0 ? `
                            <button onclick="addToCart('${art.id}', 'Archival Print', ${art.pricePrint})" class="flex-1 border border-zinc-800 text-zinc-900 text-xs font-bold py-2 rounded hover:bg-zinc-100 transition-colors">Order Print</button>
                        ` : ''}
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterCategory(cat) {
            activeCategory = cat;
            document.querySelectorAll(".filter-btn").forEach(btn => {
                btn.classList.remove("active-filter", "bg-zinc-900", "text-white");
                btn.classList.add("bg-zinc-200", "text-zinc-700");
            });
            event.target.classList.add("active-filter", "bg-zinc-900", "text-white");
            renderGallery();
        }

        function addToCart(id, type, price) {
            const art = artworkCatalog.find(a => a.id === id);
            if (!art) return;
            currentCart.push({ artId: id, title: art.title, type: type, price: price });
            updateCartUI();
            toggleCartDrawer();
        }

        function updateCartUI() {
            document.getElementById("cartCount").innerText = currentCart.length;
            const container = document.getElementById("cartItems");
            const totalEl = document.getElementById("cartTotal");

            if (currentCart.length === 0) {
                container.innerHTML = `<p class="text-zinc-500 text-center py-10">Your cart is currently empty.</p>`;
                totalEl.innerText = "₹0";
                return;
            }

            let sum = 0;
            container.innerHTML = "";
            currentCart.forEach((item, index) => {
                sum += item.price;
                const div = document.createElement("div");
                div.className = "flex justify-between items-center p-3 bg-zinc-50 rounded border border-zinc-200 text-sm";
                div.innerHTML = `
