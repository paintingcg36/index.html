                <p class="text-zinc-500 text-sm mt-3">Loading artworks...</p>
            </div>
        </div>
    </section>

    <!-- ABOUT ARTIST SECTION -->
    <section id="about" class="bg-zinc-900 text-zinc-200 py-16 border-t border-zinc-800">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
            <h2 class="font-heading text-3xl font-bold text-brand-gold">About Rakesh Kumar Sahu</h2>
            <p class="text-zinc-400 leading-relaxed max-w-3xl mx-auto">
                Based in India, Rakesh Kumar Sahu is a passionate fine artist working across diverse traditional and contemporary mediums. 
                His portfolio ranges from textured acrylic canvases and expressive watercolor landscapes to detailed charcoal sketches and modern digital art. 
                Every original piece and fine art print is crafted with precision and carefully packaged for collectors.
            </p>
        </div>
    </section>

    <!-- CUSTOM ORDER & COMMISSION SECTION -->
    <section id="commission" class="py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white p-8 sm:p-12 rounded-xl shadow-lg border border-zinc-200">
            <h2 class="font-heading text-2xl sm:text-3xl font-bold text-zinc-900 mb-2">Custom Artwork &amp; Commission Request</h2>
            <p class="text-zinc-600 text-sm mb-8">Looking for a custom painting or specific size? Fill out the details below to request a personalized artwork.</p>
            
            <form id="commissionForm" onsubmit="handleCommissionSubmit(event)" class="space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">Your Full Name</label>
                        <input type="text" id="commName" required class="w-full border border-zinc-300 rounded px-4 py-3 text-sm focus:outline-none focus:border-brand-gold">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">Mobile / WhatsApp Number</label>
                        <input type="tel" id="commPhone" required placeholder="+91 98765 43210" class="w-full border border-zinc-300 rounded px-4 py-3 text-sm focus:outline-none focus:border-brand-gold">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">Preferred Medium</label>
                        <select id="commMedium" class="w-full border border-zinc-300 rounded px-4 py-3 text-sm focus:outline-none focus:border-brand-gold">
                            <option value="Acrylic Canvas">Acrylic on Canvas</option>
                            <option value="Watercolor">Watercolor Paper</option>
                            <option value="Charcoal Sketch">Charcoal Sketch</option>
                            <option value="Digital Art">Digital Illustration</option>
                            <option value="Mixed Media">Mixed Media</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">Estimated Budget (₹ INR)</label>
                        <input type="text" id="commBudget" placeholder="E.g., ₹10,000 - ₹25,000" class="w-full border border-zinc-300 rounded px-4 py-3 text-sm focus:outline-none focus:border-brand-gold">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-zinc-700 mb-2">Artwork Specifications &amp; Notes</label>
                    <textarea id="commNotes" rows="4" placeholder="Describe canvas dimensions (e.g., 18x24 in), subject matter, colors, or reference concepts..." class="w-full border border-zinc-300 rounded px-4 py-3 text-sm focus:outline-none focus:border-brand-gold"></textarea>
                </div>

                <button type="submit" id="commSubmitBtn" class="w-full bg-zinc-900 text-white font-bold py-4 rounded hover:bg-brand-gold hover:text-zinc-900 transition-colors uppercase tracking-widest text-sm">
                    Submit Commission Request
                </button>
            </form>
        </div>
    </section>

    <!-- SHOPPING CART DRAWER -->
    <div id="cartDrawer" class="fixed inset-0 z-50 overflow-hidden hidden">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="toggleCartDrawer()"></div>
        <div class="absolute inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-white shadow-xl flex flex-col">
                <div class="p-6 bg-zinc-900 text-white flex items-center justify-between">
                    <h3 class="font-heading text-lg font-bold">Your Order Cart</h3>
                    <button onclick="toggleCartDrawer()" class="text-zinc-400 hover:text-white" aria-label="Close Cart"><i class="fa-solid fa-xmark text-xl"></i></button>
                </div>
                <div id="cartItems" class="flex-1 overflow-y-auto p-6 space-y-4">
                    <p class="text-zinc-500 text-center py-10">Your cart is currently empty.</p>
                </div>
                <div class="p-6 border-t border-zinc-200 bg-zinc-50 space-y-4">
                    <div class="flex justify-between font-bold text-zinc-900 text-lg">
                        <span>Total Amount:</span>
                        <span id="cartTotal">₹0</span>
                    </div>
                    <button onclick="processOrderCheckout()" class="w-full bg-brand-gold text-zinc-900 font-bold py-3 rounded hover:bg-yellow-500 transition-colors uppercase text-sm tracking-wider">
                        Proceed to UPI / Order Checkout
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="bg-zinc-950 text-zinc-500 text-xs py-8 border-t border-zinc-900 mt-auto">
        <div class="max-w-7xl mx-auto px-4 text-center space-y-2">
            <p>© 2026 Rakesh Kumar Sahu Fine Art. All Rights Reserved.</p>
            <p>Pan-India Delivery · UPI Payments Accepted</p>
        </div>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        let artworkCatalog = [];
        let currentCart = [];
        let activeCategory = "All";

        // Loads JSON generated by Python script from Excel file
        async function loadArtworks() {
            const grid = document.getElementById("artGrid");
            try {
                // Attempts to fetch JSON generated from Excel file
                const response = await fetch('artworks.json');
                if (!response.ok) throw new Error("artworks.json not found, using fallback catalog");
                const data = await response.json();
                
                artworkCatalog = data.map(item => ({
                    id: String(item.ID || item.id),
                    title: item.Title || item.title,
                    category: item.Category || item.category || "Acrylic",
                    medium: item.Medium || item.medium || "Mixed Medium",
                    priceOriginal: parseInt(item.Price_Original_INR || item.priceOriginal || 0),
                    pricePrint: parseInt(item.Price_Print_INR || item.pricePrint || 0),
                    availability: item.Availability || item.availability || "Available",
                    image: item.Image_URL || item.image || "https://via.placeholder.com/600",
                    description: item.Description || item.description || ""
                }));
            } catch (err) {
                console.warn(err.message);
                // Default fallback if artworks.json isn't present locally yet
                artworkCatalog = [
                    { id: "101", title: "Divine Ganesha", category: "Acrylic", medium: "Acrylic on Canvas", priceOriginal: 25000, pricePrint: 1800, availability: "Available", image: "https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=800&q=80", description: "Textured acrylic painting depicting traditional warmth." },
                    { id: "102", title: "Monsoon Serenade", category: "Watercolor", medium: "Watercolor on Paper", priceOriginal: 12000, pricePrint: 1200, availability: "Available", image: "https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&w=800&q=80", description: "Luminous watercolor painting capturing rainy mornings." },
                    { id: "103", title: "Heritage Courtyard", category: "Sketches", medium: "Charcoal on Paper", priceOriginal: 8500, pricePrint: 950, availability: "Available", image: "https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=800&q=80", description: "Detailed charcoal sketch of Indian architecture." },
                    { id: "104", title: "Varanasi Lights", category: "Digital", medium: "Digital Fine Art", priceOriginal: 0, pricePrint: 1500, availability: "Available", image: "https://images.unsplash.com/photo-1518998053901-5348d3961a04?auto=format&fit=crop&w=800&q=80", description: "Digital vector artwork celebrating evening ghats." }
                ];
            }
            renderGallery();
        }

        function renderGallery() {
            const grid = document.getElementById("artGrid");
            grid.innerHTML = "";

            const filtered = activeCategory === "All" 
                ? artworkCatalog 
                : artworkCatalog.filter(item => item.category.toLowerCase() === activeCategory.toLowerCase());

            if (filtered.length === 0) {
                grid.innerHTML = `<p class="col-span-full text-center text-zinc-500 py-10">No artworks found in this category.</p>`;
                return;
            }

            filtered.forEach(art => {
                const card = document.createElement("div");
                card.className = "bg-white rounded-lg shadow-md overflow-hidden border border-zinc-200 flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="relative h-64 overflow-hidden bg-zinc-100">
                            <img src="${art.image}" alt="${art.title}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 right-3 bg-zinc-900/80 text-brand-gold text-[10px] font-bold px-2 py-1 uppercase rounded tracking-wider backdrop-blur-sm">
                                ${art.medium}
                            </span>
                        </div>
                        <div class="p-5">
                            <h3 class="font-heading font-bold text-lg text-zinc-900">${art.title}</h3>
                            <p class="text-zinc-500 text-xs mt-1 line-clamp-2">${art.description}</p>
                            
                            <div class="mt-4 pt-3 border-t border-zinc-100 flex items-center justify-between">
                                <div>
                                    ${art.priceOriginal > 0 ? `<p class="text-xs text-zinc-500">Original: <strong class="text-zinc-900 text-sm">₹${art.priceOriginal.toLocaleString('en-IN')}</strong></p>` : ''}
                                    ${art.pricePrint > 0 ? `<p class="text-xs text-zinc-500">Print from: <strong class="text-zinc-900 text-sm">₹${art.pricePrint.toLocaleString('en-IN')}</strong></p>` : ''}
                                </div>
                                <span class="text-xs font-semibold ${art.availability === 'Available' ? 'text-emerald-600' : 'text-red-500'}">
                                    ${art.availability}
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="p-5 pt-0 flex gap-2">
                        ${art.priceOriginal > 0 && art.availability === 'Available' ? `
                            <button onclick="addToCart('${art.id}', 'Original', ${art.priceOriginal})" class="flex-1 bg-zinc-900 text-white text-xs font-bold py-2 rounded hover:bg-brand-gold hover:text-zinc-900 transition-colors">Buy Original</button>
                        ` : ''}
                        ${art.pricePrint > 0 ? `
                            <button onclick="addToCart('${art.id}', 'Archival Print', ${art.pricePrint})" class="flex-1 border border-zinc-800 text-zinc-900 text-xs font-bold py-2 rounded hover:bg-zinc-100 transition-colors">Order Print</button>
                        ` : ''}
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterCategory(cat) {
            activeCategory = cat;
            document.querySelectorAll(".filter-btn").forEach(btn => {
                btn.classList.remove("active-filter", "bg-zinc-900", "text-white");
                btn.classList.add("bg-zinc-200", "text-zinc-700");
            });
            event.target.classList.add("active-filter", "bg-zinc-900", "text-white");
            renderGallery();
        }

        function addToCart(id, type, price) {
            const art = artworkCatalog.find(a => a.id === id);
            if (!art) return;
            currentCart.push({ artId: id, title: art.title, type: type, price: price });
            updateCartUI();
            toggleCartDrawer();
        }

        function updateCartUI() {
            document.getElementById("cartCount").innerText = currentCart.length;
            const container = document.getElementById("cartItems");
            const totalEl = document.getElementById("cartTotal");

            if (currentCart.length === 0) {
                container.innerHTML = `<p class="text-zinc-500 text-center py-10">Your cart is currently empty.</p>`;
                totalEl.innerText = "₹0";
                return;
            }

            let sum = 0;
            container.innerHTML = "";
            currentCart.forEach((item, index) => {
                sum += item.price;
                const div = document.createElement("div");
                div.className = "flex justify-between items-center p-3 bg-zinc-50 rounded border border-zinc-200 text-sm";
                div.innerHTML = `
                    <div>
                        <p class="font-bold text-zinc-900">${item.title}</p>
                        <p class="text-xs text-zinc-500">${item.type}</p>
                        <p class="text-xs font-semibold text-brand-accent">₹${item.price.toLocaleString('en-IN')}</p>
                    </div>
                    <button onclick="removeFromCart(${index})" class="text-zinc-400 hover:text-red-500" aria-label="Remove Item"><i class="fa-solid fa-trash-can"></i></button>
                `;
                container.appendChild(div);
            });

            totalEl.innerText = `₹${sum.toLocaleString('en-IN')}`;
        }

        function removeFromCart(index) {
            currentCart.splice(index, 1);
            updateCartUI();
        }

        function toggleCartDrawer() {
            document.getElementById("cartDrawer").classList.toggle("hidden");
        }

        function processOrderCheckout() {
            if (currentCart.length === 0) {
                alert("Your cart is empty!");
                return;
            }

            const name = prompt("Enter your Full Name for Order Delivery:");
            const phone = prompt("Enter Mobile/WhatsApp Number for UPI Payment Link:");
            if (!name || !phone) return;

            const orderId = "RKS-" + Math.floor(1000 + Math.random() * 9000);
            alert(`Thank you ${name}! Your order ID ${orderId} has been placed. Rakesh will send the UPI payment request directly to your phone: ${phone}.`);
            currentCart = [];
            updateCartUI();
            toggleCartDrawer();
        }

        function handleCommissionSubmit(e) {
            e.preventDefault();
            alert("Your commission request has been received! Rakesh will review your specifications and get in touch with you directly.");
            document.getElementById("commissionForm").reset();
        }

        // Initialize gallery on page startup
        loadArtworks();
    </script>
</body>
</html>m").reset();
        }

        // Initialize gallery on page startup
        loadArtworks();
    </script>
</body>
